// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. It names the bundle, the executable inside it, and
// the app menu next to the Apple logo - so it is the name Finder, the Dock and
// the menu bar all show, and it has to be the real one rather than the package
// name pubspec.yaml carries.
PRODUCT_NAME = The Sims Mod Manager

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.felix.simsModManager

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Felix. All rights reserved.
