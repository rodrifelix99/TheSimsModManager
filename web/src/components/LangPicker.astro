---
import { defaultLocale, localeNames, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<select class="lang" id="lang-picker" aria-label="Language">
  {
    locales.map((code) => (
      <option value={code === defaultLocale ? '' : code} selected={code === locale}>
        {localeNames[code]}
      </option>
    ))
  }
</select>
