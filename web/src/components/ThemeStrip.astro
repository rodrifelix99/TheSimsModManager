---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Game titles stay English everywhere, the way the app itself shows them.
// These are the app's eight looks rather than its nine games - SimCity
// Societies has no chrome of its own and wears whichever one you picked - and
// they run franchise by franchise, in the order GameTheme.themeIds lists them
// rather than by year. The last chip is not a game either: it is dark mode,
// which every look has.
const chips = [
  { id: 'sims1', name: 'The Sims', era: '2000', icon: 'the_sims_1_icon.png' },
  { id: 'sims2', name: 'The Sims 2', era: '2004', icon: 'the_sims_2_icon.png' },
  { id: 'sims3', name: 'The Sims 3', era: '2009', icon: 'the_sims_3_icon.png' },
  {
    id: 'simsmedieval',
    name: 'The Sims Medieval',
    era: '2011',
    icon: 'the_sims_medieval_icon.webp',
  },
  { id: 'sims4', name: 'The Sims 4', era: '2014', icon: 'the_sims_4_icon.png' },
  { id: 'simcity3000', name: 'SimCity 3000', era: '1999', icon: 'simcity_3000_icon.png' },
  { id: 'simcity4', name: 'SimCity 4', era: '2003', icon: 'simcity_4_icon.webp' },
  { id: 'simcity2013', name: 'SimCity', era: '2013', icon: 'simcity_2013_icon.png' },
  { id: 'dark', name: t.plain('themes.dark'), era: t.plain('themes.darkEra') },
];

// Game titles stay English inside the alt text too, so the sentence around
// them is the only part that is translated.
const shotAlt = (game: string) => t.plain('themes.shotAlt').replace('%s', game);

// Every game has a shot of its own now, so the chips show the real thing
// rather than the Sims 4 one standing in. The dark chip is the Sims 4 dark
// palette, the app's own default, and its shot has to be one of these too:
// they are all the same window at the same size, so switching chips swaps
// the picture without the layout moving under it.
const shots: Record<string, [string, string]> = {
  sims1: ['library-grid-ts1.png', shotAlt('The Sims')],
  sims2: ['library-grid-ts2.png', shotAlt('The Sims 2')],
  sims3: ['library-grid-ts3.png', shotAlt('The Sims 3')],
  simsmedieval: ['library-grid-tsm.png', shotAlt('The Sims Medieval')],
  sims4: ['library-grid-ts4.png', t.plain('hero.shotAlt')],
  simcity3000: ['library-grid-sc3000.png', shotAlt('SimCity 3000')],
  simcity4: ['library-grid-sc4.png', shotAlt('SimCity 4')],
  simcity2013: ['library-grid-sc2013.png', shotAlt('SimCity')],
  dark: ['library-grid-ts4-dark-mode.png', t.plain('themes.darkAlt')],
};

const themeStrings = Object.fromEntries(
  chips.map(({ id }) => [
    id,
    { src: `/images/${shots[id][0]}`, alt: shots[id][1], caption: t(`themes.cap.${id}`) },
  ]),
);
---

<div class="themes wrap">
  <h2 data-reveal="0" set:html={t('themes.h2')} />
  <p class="lead" data-reveal="0.05" set:html={t('themes.lead')} />
  <div class="theme-chips" id="theme-chips" data-reveal="0.1">
    {
      chips.map((chip) => (
        <button class:list={['chip', { active: chip.id === 'sims4' }]} data-theme={chip.id}>
          {chip.icon ? (
            <img src={`/images/games/${chip.icon}`} alt="" />
          ) : (
            <span class="swatch" />
          )}
          <span>
            {chip.name}
            <small>{chip.era}</small>
          </span>
        </button>
      ))
    }
  </div>
  <p class="shot-caption" id="shot-caption" data-reveal="0.14" set:html={t('themes.cap.sims4')} />
</div>

<script type="application/json" id="theme-strings" set:html={JSON.stringify(themeStrings)} />

<script>
  import { wireThemeSwitcher } from '../scripts/theme-switcher';
  wireThemeSwitcher();
</script>
