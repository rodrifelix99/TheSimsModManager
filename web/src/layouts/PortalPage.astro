---
// The Exchange's creator portal: sign in, list what you published, publish more.
// Three views in one page, swapped by the script; nothing here is server-side.
import Base from './Base.astro';
import Diamond from '../components/Diamond.astro';
import FormatBar from '../components/FormatBar.astro';
import LangPicker from '../components/LangPicker.astro';
import { localePath, portalStrings, useTranslations, type Locale } from '../i18n';
import { games } from '../data/games';
import '../styles/motion.css';
import '../styles/portal.css';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localePath(locale);
const withHome = (key: string) => t(key).replace('%link%', home);
const ticker = ['portal.ticker1', 'portal.ticker2', 'portal.ticker3', 'portal.ticker4'];
---

<Base
  locale={locale}
  base="portal/"
  title={t.plain('portal.meta.title')}
  description={t.plain('portal.meta.description')}
  ogTitle="The Exchange · The Sims Mod Manager"
>
  <header>
    <div class="top">
      <a class="brand-link" href={home}>
        <span class="mark"><Diamond /><span class="gleam"></span></span>
        <span class="brand">
          <strong>The Exchange</strong>
          <span set:html={t('portal.brand.sub')} />
        </span>
      </a>
      <div class="who">
        <span class="who-name hidden" id="who-name"></span>
        <LangPicker locale={locale} />
        <a class="btn ghost small" id="btn-home" href={home} set:html={t('portal.back')} />
        <button class="btn ghost small hidden" id="btn-signout" set:html={t('portal.signOut')}
        ></button>
      </div>
    </div>
  </header>

  <!-- The alpha's own announcements, on a loop. Doubled so it wraps seamlessly. -->
  <div class="ticker">
    <div class="track">
      {
        [0, 1].map(() => (
          <div class="run" aria-hidden="true">
            {ticker.map((key) => (
              <span set:html={t(key)} />
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <main>
    <div class="glow glow-a"></div>
    <div class="glow glow-b"></div>
    <div class="inner">
      <!-- ============ AUTH ============ -->
      <section id="view-auth" class="hidden">
        <div class="pitch-row">
          <div class="pitch">
            <div class="eyebrow" data-reveal="0" set:html={t('portal.pitch.eyebrow')} />
            <h1 data-reveal="0.06" set:html={t('portal.pitch.h1')} />
            <p class="sub" data-reveal="0.12" set:html={withHome('portal.pitch.p')} />

            <div class="steps" data-reveal="0.18">
              <div class="wire"></div>
              <div class="row">
                {
                  [1, 2, 3].map((step) => (
                    <div class="step">
                      <span class="n">{step}</span>
                      <b set:html={t(`portal.step${step}.b`)} />
                      <p set:html={t(`portal.step${step}.p`)} />
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="chips" data-reveal="0.24">
              <span set:html={t('portal.pitch.chip1')} />
              <span set:html={t('portal.pitch.chip2')} />
              <span set:html={t('portal.pitch.chip3')} />
            </div>
          </div>

          <div class="auth-wrap" data-reveal="0.1">
            <div class="card auth-card">
              <div class="head">
                <h2 id="auth-title" set:html={t('portal.auth.signIn')} />
                <span class="free" set:html={t('portal.auth.free')} />
              </div>
              <p class="sub" id="auth-sub" set:html={t('portal.auth.signInSub')} />

              <button class="btn google" id="btn-google">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"
                  ><path
                    fill="#FFC107"
                    d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"
                  ></path><path
                    fill="#FF3D00"
                    d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
                  ></path><path
                    fill="#4CAF50"
                    d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"
                  ></path><path
                    fill="#1976D2"
                    d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C41.4 34.9 44 30 44 24c0-1.3-.1-2.6-.4-3.9z"
                  ></path></svg
                >
                <span set:html={t('portal.auth.google')} />
              </button>

              <div class="divider"><span set:html={t('portal.auth.or')} /></div>

              <form id="form-auth">
                <label for="auth-email" set:html={t('portal.auth.email')} />
                <input
                  type="email"
                  id="auth-email"
                  autocomplete="email"
                  placeholder="you@example.com"
                  required
                />
                <div class="pass-row">
                  <label for="auth-pass" set:html={t('portal.auth.password')} />
                  <button class="linklike" type="button" id="btn-reset"
                    set:html={t('portal.auth.forgot')}></button>
                </div>
                <input
                  type="password"
                  id="auth-pass"
                  autocomplete="current-password"
                  placeholder="••••••••"
                  minlength="6"
                  required
                />
                <div class="error" id="auth-error"></div>
                <button class="btn" type="submit" id="btn-auth">
                  <span class="gleam"></span>
                  <span id="btn-auth-label" set:html={t('portal.auth.signIn')} />
                </button>
              </form>

              <div class="switch">
                <span id="auth-switch-prompt" set:html={t('portal.auth.newHere')} />
                <button class="linklike" id="btn-auth-mode" set:html={t('portal.auth.signUp')}
                ></button>
              </div>
            </div>
            <p class="auth-legal" set:html={t('portal.auth.legal')} />
          </div>
        </div>
      </section>

      <!-- ============ MOD LIST ============ -->
      <section id="view-mods" class="hidden">
        <div class="topbar" data-reveal="0">
          <div>
            <h1 set:html={t('portal.mods.h1')} />
            <p class="sub" set:html={t('portal.mods.sub')} />
          </div>
          <button class="btn" id="btn-new">
            <span class="gleam"></span>
            <span set:html={t('portal.mods.new')} />
          </button>
        </div>

        <div class="filters hidden" id="mod-filters">
          <button data-filter="all" class="on"></button>
          <button data-filter="live"></button>
          <button data-filter="draft"></button>
          <span class="tally" id="mod-tally"></span>
        </div>

        <div class="mod-grid" id="mod-list"></div>
        <div class="error" id="mods-error"></div>

        <div class="empty hidden" id="mods-empty">
          <span class="gem"><span class="gleam"></span></span>
          <h2 set:html={t('portal.mods.emptyH2')} />
          <p class="sub" set:html={t('portal.mods.emptyP')} />
          <button class="btn" id="btn-first">
            <span class="gleam"></span>
            <span set:html={t('portal.mods.emptyCta')} />
          </button>
          <div class="chips">
            <span set:html={t('portal.pitch.chip1')} />
            <span set:html={t('portal.pitch.chip2')} />
          </div>
        </div>
      </section>

      <!-- ============ EDITOR ============ -->
      <section id="view-editor" class="hidden">
        <div class="topbar">
          <div>
            <h1 id="editor-title" set:html={t('portal.editor.newTitle')} />
            <p class="sub" set:html={t('portal.editor.subtitle')} />
          </div>
          <button class="btn ghost small" id="btn-back" set:html={t('portal.editor.back')}></button>
        </div>

        <div class="editor-row">
          <form id="form-editor">
            <div class="card">
              <h2 set:html={t('portal.editor.secBasics')} />
              <label for="f-name" set:html={t('portal.editor.name')} />
              <input
                id="f-name"
                maxlength="100"
                required
                placeholder={t.plain('portal.editor.namePlaceholder')}
              />
              <div class="hint" set:html={t('portal.editor.nameHint')} />
              <label for="f-group">
                <Fragment set:html={t('portal.editor.group')} />{' '}
                <span class="opt" set:html={t('portal.editor.optional')} />
              </label>
              <input
                id="f-group"
                maxlength="60"
                list="group-names"
                placeholder={t.plain('portal.editor.groupPlaceholder')}
              />
              {/* The sets you already have, so the second colour is a pick
                  rather than a retyping: a typo would leave it on its own. */}
              <datalist id="group-names"></datalist>
              <div class="hint" set:html={t('portal.editor.groupHint')} />
              <div class="row">
                <div class="grow">
                  <label for="f-game" set:html={t('portal.editor.game')} />
                  <select id="f-game" required>
                    {
                      games.map((game) => (
                        <option value={game.id} selected={game.id === 'sims4'}>
                          {game.name}
                        </option>
                      ))
                    }
                  </select>
                </div>
                <div>
                  <label for="f-version" set:html={t('portal.editor.version')} />
                  <input
                    id="f-version"
                    maxlength="40"
                    required
                    placeholder={t.plain('portal.editor.versionPlaceholder')}
                  />
                  <div class="hint" set:html={t('portal.editor.versionHint')} />
                </div>
                <div>
                  <label for="f-author" set:html={t('portal.editor.author')} />
                  <input
                    id="f-author"
                    maxlength="60"
                    required
                    placeholder={t.plain('portal.editor.authorPlaceholder')}
                  />
                  <div class="hint" set:html={t('portal.editor.authorHint')} />
                </div>
              </div>
            </div>

            <div class="card">
              <h2 set:html={t('portal.editor.secWhat')} />
              <label for="f-desc" set:html={t('portal.editor.description')} />
              <FormatBar locale={locale} for="f-desc" />
              <textarea
                id="f-desc"
                maxlength="6000"
                required
                placeholder={t.plain('portal.editor.descriptionPlaceholder')}></textarea>
              <div class="hint" set:html={t('portal.editor.fmt.hint')} />
              <label for="f-notes">
                <Fragment set:html={t('portal.editor.notes')} />{' '}
                <span class="opt" set:html={t('portal.editor.optional')} />
              </label>
              <FormatBar locale={locale} for="f-notes" />
              <textarea
                id="f-notes"
                maxlength="6000"
                class="notes"
                placeholder={t.plain('portal.editor.notesPlaceholder')}></textarea>

              {/* Filled in by the browser from the pack catalog, because
                  which packs exist depends on the game picked above. Hidden
                  whole for a game that has none to offer. */}
              <div class="packs hidden" id="packs-block">
                <label for="f-packs-search">
                  <Fragment set:html={t('portal.editor.requires')} />{' '}
                  <span class="opt" set:html={t('portal.editor.optional')} />
                </label>
                <input
                  id="f-packs-search"
                  type="search"
                  autocomplete="off"
                  placeholder={t.plain('portal.editor.requiresSearch')}
                />
                <div class="pack-list" id="pack-list"></div>
                <p class="pack-tally" id="pack-tally"></p>
                <div class="hint" set:html={t('portal.editor.requiresHint')} />
              </div>
            </div>

            <div class="card">
              <h2>
                <Fragment set:html={t('portal.editor.images')} />{' '}
                <span class="opt" set:html={t('portal.editor.imagesOpt')} />
              </h2>
              <div class="filebox slim" id="box-images">
                <div>
                  <b set:html={t('portal.editor.imagesBox')} />
                  <small set:html={t('portal.editor.imagesHint')} />
                </div>
              </div>
              <input type="file" id="f-images" accept="image/*" multiple class="hidden" />
              {/* A picture that was refused is said so here rather than in the
                  error box under the save button, which is three cards away
                  from where the creator is looking. */}
              <div class="error" id="images-error"></div>
              <div class="imgs" id="images-grid"></div>
            </div>

            <div class="card">
              <h2 set:html={t('portal.editor.file')} />
              <div class="filebox" id="box-file">
                <div>
                  <span class="arrow">↓</span>
                  <b set:html={t('portal.editor.fileBox')} />
                  <small set:html={t('portal.editor.fileHint')} />
                </div>
              </div>
              <input
                type="file"
                id="f-file"
                class="hidden"
                accept=".package,.ts4script,.zip,.rar,.7z,.iff,.far,.skn,.cmx,.bmp,.wll,.flr"
              />
              <div class="picked hidden" id="file-picked">
                <span class="dot"></span>
                <span class="what">
                  <b id="file-name"></b>
                  <small id="file-hint"></small>
                </span>
              </div>
              <div class="hint" set:html={t('portal.editor.fileNote')} />
            </div>

            <div class="card publish-card">
              <div class="copy">
                <b set:html={t('portal.editor.publishLabel')} />
                <small set:html={t('portal.editor.publishHint')} />
              </div>
              <label class="toggle">
                <input type="checkbox" id="f-published" checked />
                <span class="pill"></span>
              </label>
            </div>

            <div class="error" id="editor-error"></div>
            <div class="bar" id="upload-bar"><div></div></div>

            <div class="editor-actions">
              <button class="btn" type="submit" id="btn-save">
                <span class="gleam"></span>
                <span id="btn-save-label" set:html={t('portal.editor.save')} />
              </button>
              <button class="btn danger hidden" type="button" id="btn-delete">
                <span set:html={t('portal.editor.delete')} />
              </button>
            </div>
            <p class="legal" set:html={t('portal.editor.legal')} />
          </form>

          <aside>
            <div class="card preview">
              <div class="cap" set:html={t('portal.editor.preview')} />
              <div class="cover">
                <img id="pv-image" class="hidden" src="" alt="" />
                <span class="ext" id="pv-ext">.package</span>
              </div>
              <div class="body">
                <div class="line">
                  <h3 id="pv-name" set:html={t('portal.editor.namePlaceholder')} />
                  <span class="ver" id="pv-version">v1.0</span>
                </div>
                <p class="by" id="pv-by"></p>
                <span class="btn" set:html={t('portal.editor.install')} />
              </div>
            </div>
            <div class="card tips">
              <b set:html={t('portal.editor.tips')} />
              <ul>
                <li set:html={t('portal.editor.tip1')} />
                <li set:html={t('portal.editor.tip2')} />
                <li set:html={t('portal.editor.tip3')} />
              </ul>
            </div>
          </aside>
        </div>
      </section>
    </div>
  </main>

  <footer set:html={withHome('portal.footer')} />

  <script
    type="application/json"
    id="portal-strings"
    set:html={JSON.stringify(portalStrings(locale))}
  />
  <script>
    import { startPortal } from '../scripts/portal';
    startPortal();
  </script>
</Base>
